{
  "name": "micro-drama-studio",
  "version": "0.1.0",
  "private": true,
  "description": "AI pipeline: idea -> script -> generated clips -> vertical episode",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run build",
    "dev": "concurrently -k -n tsc,api,worker -c gray,cyan,magenta \"npm:dev:tsc\" \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:api": "node --watch --enable-source-maps dist/main.api.js",
    "dev:worker": "node --watch --enable-source-maps dist/main.worker.js",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "sample-media": "bash scripts/make-sample-media.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "bullmq": "^6.3.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "typescript": "~5.9"
  }
}
